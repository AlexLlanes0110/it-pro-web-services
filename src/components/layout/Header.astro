---
import { contactConfig } from "../../config/contact";
import { navigationItems } from "../../config/navigation";
import { siteConfig } from "../../config/site";
import { buildWhatsAppUrl } from "../../utils/whatsapp";
import LanguageSwitch from "./LanguageSwitch.astro";

const whatsappUrl = buildWhatsAppUrl(contactConfig.whatsapp);
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-[#020617]/90 backdrop-blur"
>
  <div
    class="mx-auto flex min-h-20 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6 lg:px-8"
  >
    <a
      href="#inicio"
      class="flex min-w-0 items-center gap-3 rounded-md text-slate-50 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
      aria-label={`Ir al inicio de ${siteConfig.name}`}
    >
      <span
      class="grid h-10 w-10 shrink-0 place-items-center rounded-md border border-sky-400/40 bg-sky-400/10"  
      aria-hidden="true"
    >
      <img
        src="/images/graphics/itpro-icon.svg"
        alt=""
        class="h-9 w-9 invert"
      />
      </span>
      <span class="min-w-0">
        <span class="block text-base font-semibold leading-tight">
          {siteConfig.name}
        </span>
        <span class="hidden text-xs leading-tight text-slate-400 sm:block">
          {siteConfig.fullName}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <LanguageSwitch />
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-white/10 bg-white/5 text-sm font-semibold text-slate-100 transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir navegación"
      >
        <span class="grid gap-1" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
        </span>
      </summary>

      <div
        class="absolute right-0 top-12 w-[min(20rem,calc(100vw-2.5rem))] rounded-md border border-white/10 bg-[#0f172a] p-3 shadow-2xl shadow-slate-950/50"
      >
        <nav class="grid gap-1" aria-label="Navegación móvil">
          {
            navigationItems.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-3 grid gap-3 border-t border-white/10 pt-3">
          <LanguageSwitch />
          <a
            href={whatsappUrl}
            class="inline-flex items-center justify-center rounded-md bg-sky-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {contactConfig.whatsapp.label}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
