---
import { contactConfig } from "../../config/contact";
import { buildWhatsAppUrl } from "../../utils/whatsapp";

const whatsappUrl = buildWhatsAppUrl(contactConfig.whatsapp);
---

<a
  href={whatsappUrl}
  class="fixed bottom-5 right-5 z-50 grid h-14 w-14 place-items-center rounded-full border border-lime-300/30 bg-lime-400 text-slate-950 shadow-xl shadow-slate-950/30 transition hover:bg-lime-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime-300"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={contactConfig.whatsapp.label}
>
  <img
    src="/images/graphics/whatsapp-icon.svg"
    alt=""
    class="h-7 w-7"
    aria-hidden="true"
  />
</a>
