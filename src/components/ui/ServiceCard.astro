---
type Props = {
  title: string;
  description: string;
  iconSrc?: string;
  iconAlt?: string;
  items?: string[];
  class?: string;
};

const {
  title,
  description,
  iconSrc,
  iconAlt,
  items = [],
  class: className = "",
} = Astro.props;

const hasItems = items.length > 0;
---

<article
  class:list={[
    "h-full rounded-md border border-white/10 bg-white/[0.03] p-6 transition hover:border-sky-300/40 hover:bg-white/[0.05]",
    className,
  ]}
>
  {
    iconSrc && (
      <div class="mb-5 grid h-12 w-12 place-items-center rounded-md border border-sky-300/20 bg-sky-400/10">
        <img
          src={iconSrc}
          alt={iconAlt ?? ""}
          class="h-7 w-7 object-contain"
          loading="lazy"
        />
      </div>
    )
  }

  <h3 class="text-lg font-semibold leading-7 text-slate-50">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-slate-300">{description}</p>

  {
    hasItems && (
      <ul class="mt-5 grid gap-2 text-sm leading-6 text-slate-300">
        {items.map((item) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-lime-300" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
