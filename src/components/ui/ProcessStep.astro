---
type Props = {
  step: string | number;
  title: string;
  description: string;
  class?: string;
};

const { step, title, description, class: className = "" } = Astro.props;
const stepLabel = typeof step === "number" ? String(step).padStart(2, "0") : step;
---

<article
  class:list={[
    "h-full rounded-md border border-white/10 bg-white/[0.03] p-6 transition hover:border-sky-300/40 hover:bg-white/[0.05]",
    className,
  ]}
>
  <div
    class="mb-5 inline-flex h-10 min-w-10 items-center justify-center rounded-md border border-sky-300/30 bg-sky-400/10 px-3 text-sm font-semibold text-sky-100"
  >
    {stepLabel}
  </div>
  <h3 class="text-lg font-semibold leading-7 text-slate-50">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-slate-300">{description}</p>
</article>
